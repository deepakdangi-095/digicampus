# Copy to .env next to docker-compose.yml. Everything has a demo default; change ALL secrets before going live.
POSTGRES_PASSWORD=digicampus
JWT_SECRET=change-me-to-a-long-random-string
CAMPUS_PASS_SECRET=change-me-to-a-different-long-random-string
GATE_API_KEY=change-me-device-key
AI_SERVICE_API_KEY=change-me-ai-key
OPENAI_API_KEY=                      # optional: LLM answers + self-argument critic (build AI with AI_DENSE=1 for FAISS too)
AI_DENSE=0
SEED_ON_START=1                      # demo data on first boot; 0 for production
PUBLIC_API_URL=http://localhost:4000 # what the BROWSER uses to reach the API (baked into the web build)
CORS_ORIGINS=*
